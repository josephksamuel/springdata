## 3. Service Layer Example

```java
import org.springframework.stereotype.Service;
import org.springframework.beans.factory.annotation.Autowired;
import java.util.List;

@Service
public class EmployeeService {

    @Autowired
    private EmployeeRepository repository;

    public PageResult<Employee> getEmployeesByDepartment(
            String department, int pageNumber, int pageSize) {

        // Calculate row bounds
        int startRow = (pageNumber - 1) * pageSize + 1;
        int endRow   = pageNumber * pageSize;

        // Fetch content and total count
        List<Employee> employees = repository.findByDepartmentPaged(department, startRow, endRow);
        long totalRows = repository.countByDepartment(department);

        // Wrap into PageResult
        return new PageResult<>(employees, totalRows, pageNumber, pageSize);
    }
}
```

