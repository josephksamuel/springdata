Perfect 👍 let’s wire up the custom `PageResult<T>` into the **service layer** so you can use it like Spring Data’s `Page<T>` — but in a way that works for **DB2 < 10.5** with `ROW_NUMBER()` pagination.

---

## 1. Repository with Native Query

```java
import org.springframework.data.jpa.repository.Query;
import org.springframework.data.repository.query.Param;
import org.springframework.data.jpa.repository.JpaRepository;
import java.util.List;

public interface EmployeeRepository extends JpaRepository<Employee, Long> {

    @Query(
        value = "SELECT * FROM (" +
                " SELECT e.*, ROW_NUMBER() OVER (ORDER BY e.ID) AS rn" +
                " FROM EMPLOYEE e WHERE e.DEPARTMENT = :dept" +
                ") sub WHERE rn BETWEEN :startRow AND :endRow",
        nativeQuery = true
    )
    List<Employee> findByDepartmentPaged(
        @Param("dept") String department,
        @Param("startRow") int startRow,
        @Param("endRow") int endRow
    );

    @Query(
        value = "SELECT COUNT(*) FROM EMPLOYEE e WHERE e.DEPARTMENT = :dept",
        nativeQuery = true
    )
    long countByDepartment(@Param("dept") String department);
}
```

